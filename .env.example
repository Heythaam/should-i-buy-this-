# Optional: HTTP(S) proxy URL used by the Tier 2 (Playwright) scraper.
# Leave unset to make requests without a proxy.
SCRAPER_PROXY_URL=

# Optional: path to a local Chromium/Chrome executable for Playwright to
# launch instead of the browser it manages itself. Set this only if
# `playwright install` can't download browsers in your environment (e.g.
# cdn.playwright.dev is blocked) and you have a compatible browser already
# installed locally. Leave unset to use Playwright's own managed browser.
PLAYWRIGHT_EXECUTABLE_PATH=

# Required for LLM synthesis (Story 1.7): OpenAI API key, never hardcoded.
OPENAI_API_KEY=

# Optional: override the default cheap (theme-clustering) / strong
# (final-synthesis) model names.
LLM_CHEAP_MODEL=
LLM_STRONG_MODEL=

# Optional: point the OpenAI SDK at an OpenAI-compatible API instead of
# api.openai.com (e.g. Groq: https://api.groq.com/openai/v1). Leave unset to
# use the SDK's own default.
OPENAI_BASE_URL=
